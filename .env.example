# Backend
PORT=8080
NODE_ENV=development

# MongoDB URI (replica set)
MONGODB_URI=mongodb://127.0.0.1:27017,127.0.0.1:27018,127.0.0.1:27019/charity_distributed?replicaSet=rsCharity
# FE dev port in this workspace is 5174.
# You can set multiple origins separated by commas for Tailscale machines.
CORS_ORIGIN=http://localhost:5174,http://<TAILSCALE_FE_IP>:5174

# JWT Authentication
# SECURITY: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-generate-unique-per-environment
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
