# Backend
PORT=8080
NODE_ENV=development

# MongoDB sharded cluster entry point.
# Backend must connect to mongos on May 1, not directly to shard replica set members.
MONGODB_URI=mongodb://100.105.34.84:27017/charity_distributed

# FE dev port in this workspace is 5174.
# Keep localhost for local browser access and Tailscale IP for other team members.
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://100.105.34.84:5174

# JWT Authentication
# SECURITY: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-generate-unique-per-environment
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
