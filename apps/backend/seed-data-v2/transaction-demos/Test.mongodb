        }
    });

    demo01TxDb.campaigns.updateOne({
        _id: ObjectId('69f8abd423a1fb7452628cac')
    }, {
        $inc: { currentAmount: 50000 }
    });

    demo01TxDb.activity_logs.insertOne({
        branchId: ObjectId('660000000000000000000004'),
        targetBranchId: ObjectId('660000000000000000000004'),
        actorId: ObjectId('69f8ac0823a1fb7452628dd4'),
