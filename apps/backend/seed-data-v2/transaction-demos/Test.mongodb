var demo01Session = db.getMongo().startSession();
var demo01TxDb = demo01Session.getDatabase("charity_distributed");

function findBranch(id) {
    return db.branches.findOne({ _id: ObjectId(id) });
}

var branch = findBranch('660000000000000000000002');

print(branch._id)

try {
    demo01Session.startTransaction();

    var contributionDemo = demo01TxDb.contributions.insertOne({
        branchId: branch._id,
        campaignId: ObjectId('69f8c4186cb6efce2b628cac'),
        contributorId: ObjectId('69f8c4216cb6efce2b628cc4'),
        type: 'MONEY',
        status: 'PENDING',
        receivedAt: null,
        createdBy: ObjectId('69f8c4266cb6efce2b628cf6'),
        contributorSnapshot: {
            fullName: 'Hieu Ngu',
            organizationName: null,
            phone: '0820000007',
            email: 'contributor007@example.com',
            type: 'INDIVIDUAL'
        },
        campaignSnapshot: {
            code: 'DN-S3-CMP-01',
            title: 'Chien dich Tien mat - Da Nang'
        },
        branchSnapshot: {
            code: 'DN-S3',
            name: 'Chi nhanh Da Nang'
        },
        proofs: [
            {
                type: 'RECEIPT',
                url: 'https://example.com/proofs/contribution-0021.pdf',
                description: 'Seed proof for contribution 21',
                uploadedAt: ISODate('2024-02-29T17:00:00.000Z')
            }
        ],
        createdAt: ISODate('2024-02-29T17:00:00.000Z'),
        updatedAt: ISODate('2024-02-29T17:00:00.000Z'),
        moneyDetail: {
            amount: NumberInt('625000'),
            currency: 'VND',
            paymentMethod: 'CASH',
            paymentStatus: 'SUCCESS',
            transactionCode: 'TXN-DN-S3-0001',
            paidAt: ISODate('2024-02-29T17:00:00.000Z')
        }
    });

    if (contributionDemo.type != 'MONEY') {
        throw new Error('Contribution type is not MONEY');
    }

    demo01Session.commitTransaction();
    print('Transaction committed successfully.');
} catch (err) {
    demo01Session.abortTransaction();
    print('Transaction aborted due to error: ' + err);
} finally {
    demo01Session.endSession();
}
