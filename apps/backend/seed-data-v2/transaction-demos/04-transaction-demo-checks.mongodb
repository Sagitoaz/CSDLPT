// Demo 04: checks after running transaction demos.
// Copy-paste directly into mongosh.

db = db.getSiblingDB("charity_distributed");

print("Transaction demo records:");
printjson({
  contributionDemoCount: db.contributions.countDocuments({ demoBatch: /^TX-DEMO-CONTRIB-/ }),
  aidDemoCount: db.aid_distributions.countDocuments({ demoBatch: /^TX-DEMO-AID-/ }),
  rollbackLeakCount: db.activity_logs.countDocuments({ demoBatch: /^TX-DEMO-ROLLBACK-/ }),
  transactionAuditLogCount: db.activity_logs.countDocuments({
    action: { $in: ["TX_DEMO_CONTRIBUTION_RECEIVED", "TX_DEMO_AID_COMPLETED", "TX_DEMO_SHOULD_ROLLBACK"] }
  })
});

print("");
print("Latest transaction demo audit logs:");
db.activity_logs
  .find({ action: /^TX_DEMO_/ }, { action: 1, entityType: 1, description: 1, demoBatch: 1, createdAt: 1 })
  .sort({ createdAt: -1 })
  .limit(10)
  .forEach(printjson);

print("");
print("Shard distribution commands to run live:");
print("db.contributions.getShardDistribution()");
print("db.aid_distributions.getShardDistribution()");
print("db.activity_logs.getShardDistribution()");
