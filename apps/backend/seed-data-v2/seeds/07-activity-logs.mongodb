// Seed activity_logs. This hot collection must be range-sharded by { branchId: 1 }
// in the mongos setup step before running this file.
// Copy-paste directly into mongosh connected through mongos.

db = db.getSiblingDB("charity_distributed");
db.activity_logs.deleteMany({});

var branches07 = db.branches.find({ status: "ACTIVE" }).sort({ _id: 1 }).toArray();
var campaigns07 = db.campaigns.find({}).sort({ branchId: 1, code: 1 }).toArray();
var contributions07 = db.contributions.find({}).sort({ createdAt: 1 }).toArray();
var aids07 = db.aid_distributions.find({}).sort({ createdAt: 1 }).toArray();
if (branches07.length === 0 || campaigns07.length === 0) {
  throw new Error("Run previous seed files first.");
}

var actions07 = [
  "CAMPAIGN_CREATED",
  "CONTRIBUTION_RECEIVED",
  "CONTRIBUTION_CONFIRMED",
  "AID_DISTRIBUTION_APPROVED",
  "AID_DISTRIBUTION_DELIVERED",
  "BENEFICIARY_VERIFIED",
  "REPORT_VIEWED"
];
var shardBranches07 = branches07;
var logs07 = [];

shardBranches07.forEach((branch, branchIndex) => {
  var campaignPool = campaigns07.filter((c) => String(c.branchId) === String(branch._id));
  var contributionPool = contributions07.filter((c) => String(c.branchId) === String(branch._id));
  var aidPool = aids07.filter((a) => String(a.branchId) === String(branch._id));

  for (var j = 0; j < 10; j += 1) {
    var n = (branchIndex * 10) + j + 1;
    var action = actions07[j % actions07.length];
    var campaign = campaignPool[j % campaignPool.length];
    var contribution = contributionPool.length ? contributionPool[j % contributionPool.length] : null;
    var aid = aidPool.length ? aidPool[j % aidPool.length] : null;
    var entityType = "Campaign";
    var entityId = String(campaign._id);
    if (action.startsWith("CONTRIBUTION") && contribution) {
      entityType = "Contribution";
      entityId = String(contribution._id);
    }
    if (action.startsWith("AID") && aid) {
      entityType = "AidDistribution";
      entityId = String(aid._id);
    }
    if (action.startsWith("BENEFICIARY")) {
      entityType = "Beneficiary";
      entityId = String(ObjectId());
    }

    logs07.push({
      _id: ObjectId(),
      branchId: branch._id,
      targetBranchId: branch._id,
      actorId: ObjectId(),
      actorRole: j % 5 === 0 ? "BRANCH_ADMIN" : "STAFF",
      actorBranchId: branch._id,
      userId: ObjectId(),
      action,
      entityType,
      entityId,
      targetType: entityType,
      targetId: entityId,
      description: `Seed activity ${n}: ${action} at ${branch.code}`,
      before: { status: j % 2 === 0 ? "PENDING" : "DRAFT" },
      after: { status: j % 3 === 0 ? "COMPLETED" : "ACTIVE" },
      changes: { seedNo: n, branchCode: branch.code },
      ipAddress: `100.105.${branchIndex + 10}.${j + 10}`,
      userAgent: "mongosh-seed-data-v2",
      createdAt: new Date(2024, branchIndex, (j % 28) + 1)
    });
  }
});

db.activity_logs.insertMany(logs07, { ordered: false });
print(`OK activity_logs inserted: ${db.activity_logs.countDocuments()}`);
print("Expected total: 50 = 10 records x 5 branches");
db.activity_logs.aggregate([{ $group: { _id: "$changes.branchCode", count: { $sum: 1 } } }, { $sort: { _id: 1 } }]).forEach(printjson);
print("Shard key: { branchId: 1 } with zone ranges. Expected placement: HP-S1->shard1RS, TH-S2->shard2RS, DN-S3->shard3RS, HCM-S4->shard4RS, BT-S5->shard5RS.");
print("Run: db.activity_logs.getShardDistribution()");
