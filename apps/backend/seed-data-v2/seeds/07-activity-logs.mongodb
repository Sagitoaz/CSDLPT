// Seed activity_logs for mongosh copy-paste.
// Uses many branchId values to spread hashed shard chunks.

db = db.getSiblingDB("charity_distributed");
db.activity_logs.drop();

try {
  if (typeof sh !== "undefined") {
    sh.enableSharding("charity_distributed");
    try {
      sh.shardCollection("charity_distributed.activity_logs", { branchId: "hashed" }, false, { numInitialChunks: 50 });
    } catch (errWithOptions) {
      sh.shardCollection("charity_distributed.activity_logs", { branchId: "hashed" });
    }
  }
} catch (err) {
  print(`Shard setup for activity_logs skipped: ${err.message}`);
}

const branches07 = db.branches.find({ status: "ACTIVE" }).sort({ code: 1 }).toArray();
const campaigns07 = db.campaigns.find({}).sort({ code: 1 }).toArray();
const contributions07 = db.contributions.find({}).sort({ createdAt: 1 }).toArray();
const aids07 = db.aid_distributions.find({}).sort({ createdAt: 1 }).toArray();
if (branches07.length === 0) {
  throw new Error("Run previous seed files first.");
}

const actions07 = [
  "CAMPAIGN_CREATED",
  "CONTRIBUTION_RECEIVED",
  "CONTRIBUTION_CONFIRMED",
  "AID_DISTRIBUTION_APPROVED",
  "AID_DISTRIBUTION_DELIVERED",
  "BENEFICIARY_VERIFIED",
  "REPORT_VIEWED"
];

const logs07 = Array.from({ length: 260 }, (_, i) => {
  const n = i + 1;
  const branch = branches07[(i * 19) % branches07.length];
  const action = actions07[i % actions07.length];
  const campaign = campaigns07[i % Math.max(campaigns07.length, 1)];
  const contribution = contributions07[i % Math.max(contributions07.length, 1)];
  const aid = aids07[i % Math.max(aids07.length, 1)];
  let entityType = "Campaign";
  let entityId = campaign ? String(campaign._id) : String(ObjectId());
  if (action.startsWith("CONTRIBUTION") && contribution) {
    entityType = "Contribution";
    entityId = String(contribution._id);
  }
  if (action.startsWith("AID") && aid) {
    entityType = "AidDistribution";
    entityId = String(aid._id);
  }
  if (action.startsWith("BENEFICIARY")) {
    entityType = "Beneficiary";
    entityId = String(ObjectId());
  }
  return {
    _id: ObjectId(),
    branchId: branch._id,
    targetBranchId: branch._id,
    actorId: ObjectId(),
    actorRole: i % 5 === 0 ? "ADMIN" : "BRANCH_STAFF",
    actorBranchId: branch._id,
    userId: ObjectId(),
    action,
    entityType,
    entityId,
    targetType: entityType,
    targetId: entityId,
    description: `Seed activity ${n}: ${action} at ${branch.code}`,
    before: { status: i % 2 === 0 ? "PENDING" : "DRAFT" },
    after: { status: i % 3 === 0 ? "COMPLETED" : "ACTIVE" },
    changes: { seedNo: n, branchCode: branch.code },
    ipAddress: `100.105.${i % 255}.${(i * 7) % 255}`,
    userAgent: "mongosh-seed-data-v2",
    createdAt: new Date(2024, i % 12, (i % 28) + 1)
  };
});

db.activity_logs.insertMany(logs07, { ordered: false });
print(`OK activity_logs inserted: ${db.activity_logs.countDocuments()}`);
