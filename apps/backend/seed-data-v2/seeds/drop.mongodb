db = db.getSiblingDB("charity_distributed");

// Keep sharding metadata for hot regional collections.
db.contributions.deleteMany({});
db.aid_distributions.deleteMany({});
db.activity_logs.deleteMany({});

db.branches.drop();
db.campaigns.drop();
db.contributors.drop();
db.beneficiaries.drop();
db.users.drop();
db.volunteers.drop();
db.stats_snapshots.drop();
