// Seed campaigns for mongosh copy-paste.

db = db.getSiblingDB("charity_distributed");
db.campaigns.drop();

const branches02 = db.branches.find({ status: "ACTIVE" }).sort({ code: 1 }).toArray();
if (branches02.length === 0) {
  throw new Error("Run 01-branches.mongodb first.");
}

const campaignTypes02 = ["FLOOD_RELIEF", "SCHOLARSHIP", "MEDICAL_SUPPORT", "FOOD_SUPPORT", "CHILD_SUPPORT", "DISASTER_RELIEF", "OTHER"];
const campaignStatuses02 = ["ACTIVE", "ACTIVE", "COMPLETED", "PAUSED", "DRAFT"];
const resourceNames02 = ["Tien mat", "Gao", "Thuoc", "Sach vo", "Quan ao", "Gio cong tinh nguyen"];

const campaigns02 = Array.from({ length: 90 }, (_, i) => {
  const n = i + 1;
  const branch = branches02[i % branches02.length];
  const type = campaignTypes02[i % campaignTypes02.length];
  const targetAmount = 30000000 + (n * 2500000);
  const currentAmount = Math.floor(targetAmount * (0.35 + ((i % 8) * 0.06)));
  const disbursedAmount = Math.floor(currentAmount * (0.25 + ((i % 5) * 0.08)));
  const startDate = new Date(2024, i % 12, (i % 20) + 1);
  const endDate = new Date(2024, (i % 12) + 1, (i % 20) + 8);
  return {
    _id: ObjectId(),
    branchId: branch._id,
    code: `CMP${String(n).padStart(4, "0")}`,
    name: `Chien dich ${String(n).padStart(3, "0")} - ${branch.province}`,
    title: `Chien dich ${String(n).padStart(3, "0")} - ${branch.province}`,
    description: `Seed campaign ${n} for distributed MongoDB shard testing.`,
    type,
    status: campaignStatuses02[i % campaignStatuses02.length],
    visibility: i % 6 === 0 ? "INTERNAL" : "PUBLIC",
    targetAmount,
    currentAmount,
    disbursedAmount,
    startDate,
    endDate,
    timeRange: { startDate, endDate },
    location: {
      province: branch.province,
      district: branch.district,
      ward: branch.ward,
      address: branch.address
    },
    goals: {
      targetMoneyAmount: targetAmount,
      targetItemSummary: resourceNames02.slice(0, (i % resourceNames02.length) + 1).join(", "),
      targetVolunteerCount: 10 + (i % 70)
    },
    requiredResources: [{
      resourceType: i % 3 === 0 ? "MONEY" : "ITEM",
      name: resourceNames02[i % resourceNames02.length],
      quantity: 10 + (i % 40),
      unit: i % 3 === 0 ? "trieu VND" : "phan",
      estimatedValue: 1000000 + (i * 150000)
    }],
    summaryStats: {
      totalMoneyReceived: currentAmount,
      totalEstimatedItemValue: 500000 + (i * 120000),
      totalVolunteerHours: 20 + (i % 90),
      totalMoneyDistributed: disbursedAmount,
      totalEstimatedAidValue: 300000 + (i * 90000),
      beneficiaryCount: 3 + (i % 35)
    },
    createdBy: ObjectId(),
    organizerId: ObjectId(),
    images: [],
    proofImages: [],
    documents: [],
    metadata: { seedBatch: "seed-data-v2", branchCode: branch.code },
    createdAt: startDate,
    updatedAt: new Date(2024, (i % 12) + 1, (i % 20) + 10)
  };
});

db.campaigns.insertMany(campaigns02, { ordered: false });
print(`OK campaigns inserted: ${db.campaigns.countDocuments()}`);
