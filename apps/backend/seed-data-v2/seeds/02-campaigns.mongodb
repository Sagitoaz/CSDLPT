// Seed campaigns aligned with the current distributed charity project.
// Campaigns are not sharded in the demo; they remain aggregate roots with branchId.

db = db.getSiblingDB("charity_distributed");
db.campaigns.drop();

var branches02 = db.branches.find({ status: "ACTIVE" }).sort({ code: 1 }).toArray();
if (branches02.length === 0) {
  throw new Error("Run 01-branches.mongodb first.");
}

var campaignTypes02 = ["FLOOD_RELIEF", "SCHOLARSHIP", "MEDICAL_SUPPORT", "FOOD_SUPPORT", "CHILD_SUPPORT", "DISASTER_RELIEF"];
var campaignStatuses02 = ["ACTIVE", "ACTIVE", "COMPLETED", "PAUSED", "DRAFT"];
var resourceNames02 = ["Tien mat", "Gao", "Thuoc", "Sach vo", "Quan ao", "Gio cong tinh nguyen"];

var campaigns02 = [];
branches02.forEach((branch, branchIndex) => {
  for (var j = 0; j < 8; j += 1) {
    var n = (branchIndex * 8) + j + 1;
    var startDate = new Date(2024, j % 12, (j * 2) + 1);
    var endDate = new Date(2024, (j % 12) + 1, (j * 2) + 8);
    var targetAmount = 50000000 + (n * 3000000);
    var currentAmount = Math.floor(targetAmount * (0.35 + ((j % 5) * 0.09)));
    var disbursedAmount = Math.floor(currentAmount * (0.25 + ((j % 4) * 0.1)));

    campaigns02.push({
      _id: ObjectId(),
      branchId: branch._id,
      code: `${branch.code}-CMP-${String(j + 1).padStart(2, "0")}`,
      name: `Chien dich ${resourceNames02[j % resourceNames02.length]} - ${branch.province}`,
      title: `Chien dich ${resourceNames02[j % resourceNames02.length]} - ${branch.province}`,
      description: `Chien dich mau cua ${branch.name}, dung cho demo dashboard va shard theo branchId.`,
      type: campaignTypes02[j % campaignTypes02.length],
      status: campaignStatuses02[j % campaignStatuses02.length],
      visibility: j % 5 === 0 ? "INTERNAL" : "PUBLIC",
      targetAmount,
      currentAmount,
      disbursedAmount,
      startDate,
      endDate,
      timeRange: { startDate, endDate },
      location: {
        province: branch.province,
        district: branch.district,
        ward: branch.ward,
        address: branch.address
      },
      goals: {
        targetMoneyAmount: targetAmount,
        targetItemSummary: resourceNames02.slice(0, (j % resourceNames02.length) + 1).join(", "),
        targetVolunteerCount: 20 + (j * 5)
      },
      requiredResources: [{
        resourceType: j % 3 === 0 ? "MONEY" : "ITEM",
        name: resourceNames02[j % resourceNames02.length],
        quantity: 10 + (j * 3),
        unit: j % 3 === 0 ? "trieu VND" : "phan",
        estimatedValue: 1000000 + (j * 500000)
      }],
      summaryStats: {
        totalMoneyReceived: currentAmount,
        totalEstimatedItemValue: 2000000 + (j * 750000),
        totalVolunteerHours: 30 + (j * 8),
        totalMoneyDistributed: disbursedAmount,
        totalEstimatedAidValue: 1000000 + (j * 550000),
        beneficiaryCount: 5 + (j * 2)
      },
      createdBy: ObjectId(),
      organizerId: ObjectId(),
      images: [],
      proofImages: [],
      documents: [],
      metadata: {
        seedBatch: "seed-data-v2",
        branchCode: branch.code,
        physicalRole: branch.address
      },
      createdAt: startDate,
      updatedAt: new Date(2024, (j % 12) + 1, (j * 2) + 10)
    });
  }
});

db.campaigns.insertMany(campaigns02, { ordered: false });
print(`OK campaigns inserted: ${db.campaigns.countDocuments()}`);
