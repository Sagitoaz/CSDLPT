// Seed beneficiaries. Beneficiaries are not sharded in the demo, but keep branchId/campaignId.

db = db.getSiblingDB("charity_distributed");
db.beneficiaries.drop();

var branches05 = db.branches.find({ status: "ACTIVE" }).sort({ _id: 1 }).toArray();
var campaigns05 = db.campaigns.find({}).sort({ branchId: 1, code: 1 }).toArray();
if (branches05.length === 0 || campaigns05.length === 0) {
  throw new Error("Run 01 and 02 seed files first.");
}

var beneficiaryTypes05 = ["INDIVIDUAL", "FAMILY", "ORGANIZATION", "COMMUNITY"];
var verificationStatuses05 = ["PENDING", "VERIFIED", "VERIFIED", "REJECTED"];
var reasons05 = ["POVERTY", "DISABILITY", "ELDERLY_ALONE", "SOCIAL_WELFARE", "DISASTER_AFFECTED"];
var beneficiaries05 = [];

branches05.forEach((branch, branchIndex) => {
  var campaignPool = campaigns05.filter((c) => String(c.branchId) === String(branch._id));

  for (var j = 0; j < 24; j += 1) {
    var n = (branchIndex * 24) + j + 1;
    var campaign = campaignPool[j % campaignPool.length];
    var type = beneficiaryTypes05[j % beneficiaryTypes05.length];
    var verificationStatus = verificationStatuses05[j % verificationStatuses05.length];

    beneficiaries05.push({
      _id: ObjectId(),
      branchId: branch._id,
      campaignId: campaign._id,
      name: `${type === "FAMILY" ? "Gia dinh" : "Nguoi nhan ho tro"} ${String(n).padStart(3, "0")} - ${branch.province}`,
      type,
      email: `beneficiary${String(n).padStart(3, "0")}@example.com`,
      phone: `07${String(30000000 + n).slice(-8)}`,
      address: {
        street: `${300 + n} Duong Ho Tro`,
        district: branch.district,
        province: branch.province,
        country: "Viet Nam"
      },
      location: {
        province: branch.province,
        district: branch.district,
        ward: branch.ward,
        address: `${300 + n} Duong Ho Tro`
      },
      householdSize: 1 + (j % 8),
      incomeLevel: j % 3 === 0 ? "VERY_LOW" : "LOW",
      reason: reasons05[j % reasons05.length],
      healthIssues: j % 4 === 0 ? ["Benh nen"] : [],
      education: ["ILLITERATE", "PRIMARY_SCHOOL", "SECONDARY_SCHOOL", "HIGH_SCHOOL"][j % 4],
      employment: ["UNEMPLOYED", "INFORMAL_JOB", "FARMER", "RETIRED"][j % 4],
      children: j % 5,
      children_ages: Array.from({ length: j % 5 }, (_, k) => 4 + k + (j % 6)),
      situationDescription: `Seed beneficiary ${n} in ${branch.province}.`,
      verificationStatus,
      verifiedBy: verificationStatus === "VERIFIED" ? ObjectId() : undefined,
      verifiedAt: verificationStatus === "VERIFIED" ? new Date(2024, branchIndex, (j % 28) + 1) : undefined,
      status: verificationStatus === "REJECTED" ? "INACTIVE" : "ACTIVE",
      createdAt: new Date(2024, branchIndex, (j % 28) + 1),
      updatedAt: new Date(2024, branchIndex, (j % 28) + 1)
    });
  }
});

db.beneficiaries.insertMany(beneficiaries05, { ordered: false });
print(`OK beneficiaries inserted: ${db.beneficiaries.countDocuments()}`);
