// Seed branches for mongosh copy-paste.
// Creates many branch ObjectIds so hashed branchId shard keys have enough variety.

db = db.getSiblingDB("charity_distributed");
db.branches.drop();

const provinces01 = [
  "Ha Noi", "TP Ho Chi Minh", "Da Nang", "Hai Phong", "Can Tho",
  "Hue", "Nghe An", "Thanh Hoa", "Binh Dinh", "Khanh Hoa",
  "Dak Lak", "Lam Dong", "Dong Nai", "Binh Duong", "An Giang",
  "Kien Giang", "Ca Mau", "Quang Ninh", "Thai Nguyen", "Lao Cai"
];

const branches01 = Array.from({ length: 60 }, (_, i) => {
  const n = i + 1;
  const province = provinces01[i % provinces01.length];
  return {
    _id: ObjectId(),
    name: n === 1 ? "Trung tam tu thien trung uong" : `Chi nhanh ${String(n).padStart(2, "0")} - ${province}`,
    code: n === 1 ? "HQ" : `BR${String(n).padStart(2, "0")}`,
    type: n === 1 ? "HEADQUARTER" : (n % 10 === 0 ? "REGIONAL_CENTER" : "BRANCH"),
    province,
    district: `Quan/Huyen ${((i % 12) + 1)}`,
    ward: `Phuong/Xa ${((i % 20) + 1)}`,
    address: `${100 + n} Duong Tu Thien, ${province}`,
    phone: `09${String(10000000 + n).slice(-8)}`,
    email: n === 1 ? "hq@charity.local" : `branch${String(n).padStart(2, "0")}@charity.local`,
    status: "ACTIVE",
    createdAt: new Date(2024, 0, (i % 28) + 1),
    updatedAt: new Date(2024, 1, (i % 28) + 1)
  };
});

db.branches.insertMany(branches01, { ordered: false });
print(`OK branches inserted: ${db.branches.countDocuments()}`);
