// Seed volunteers. Volunteers are not sharded in the demo.

db = db.getSiblingDB("charity_distributed");
db.volunteers.drop();

var branches09 = db.branches.find({ status: "ACTIVE" }).sort({ _id: 1 }).toArray();
var campaigns09 = db.campaigns.find({}).sort({ branchId: 1, code: 1 }).toArray();
if (branches09.length === 0 || campaigns09.length === 0) {
  throw new Error("Run 01 and 02 seed files first.");
}

var skills09 = ["logistics", "medical-support", "education", "warehouse", "transport", "field-survey"];
var volunteers09 = [];
branches09.forEach((branch, branchIndex) => {
  var campaignPool = campaigns09.filter((campaign) => String(campaign.branchId) === String(branch._id));
  for (var j = 0; j < 3; j += 1) {
    var n = (branchIndex * 3) + j + 1;
    volunteers09.push({
      _id: ObjectId(),
      branchId: branch._id,
      fullName: `Tinh nguyen vien ${String(n).padStart(3, "0")} - ${branch.province}`,
      phone: `089${String(2000000 + n).slice(-7)}`,
      email: `volunteer${String(n).padStart(3, "0")}@example.com`,
      skills: [skills09[j % skills09.length], skills09[(j + 2) % skills09.length]],
      joinedCampaignIds: campaignPool.slice(0, 2).map((campaign) => campaign._id),
      status: j === 7 ? "INACTIVE" : "ACTIVE",
      createdAt: new Date(2024, branchIndex, j + 1),
      updatedAt: new Date(2024, branchIndex, j + 1)
    });
  }
});

db.volunteers.insertMany(volunteers09, { ordered: false });
print(`OK volunteers inserted: ${db.volunteers.countDocuments()}`);
