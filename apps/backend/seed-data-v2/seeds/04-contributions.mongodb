// Seed contributions. This hot collection is sharded by { branchId: "hashed" }.
// Copy-paste directly into mongosh connected through mongos.

db = db.getSiblingDB("charity_distributed");
db.contributions.drop();

function setupHashedShard04(collectionName) {
  try {
    if (typeof sh !== "undefined") {
      sh.enableSharding("charity_distributed");
      try {
        sh.shardCollection(`charity_distributed.${collectionName}`, { branchId: "hashed" }, false, { numInitialChunks: 50 });
      } catch (errWithOptions) {
        sh.shardCollection(`charity_distributed.${collectionName}`, { branchId: "hashed" });
      }
    }
  } catch (err) {
    print(`Shard setup for ${collectionName} skipped: ${err.message}`);
  }
}

function moveBranchChunks04(collectionName, branches, shardNames) {
  if (typeof sh === "undefined") {
    return;
  }
  branches.forEach((branch, i) => {
    try {
      sh.moveChunk(`charity_distributed.${collectionName}`, { branchId: branch._id }, shardNames[i % shardNames.length]);
    } catch (err) {
      print(`moveChunk ${collectionName}/${branch.code} skipped: ${err.message}`);
    }
  });
}

var branches04 = db.branches.find({ status: "ACTIVE" }).sort({ _id: 1 }).toArray();
var campaigns04 = db.campaigns.find({}).sort({ branchId: 1, code: 1 }).toArray();
var contributors04 = db.contributors.find({}).sort({ email: 1 }).toArray();
if (branches04.length === 0 || campaigns04.length === 0 || contributors04.length === 0) {
  throw new Error("Run 01, 02 and 03 seed files first.");
}

var contributionTypes04 = ["MONEY", "ITEM", "MEDICINE", "CLOTHES", "BOOK", "SERVICE", "VOLUNTEER_WORK"];
var contributionStatuses04 = ["PENDING", "CONFIRMED", "RECEIVED", "RECEIVED", "REJECTED"];
var itemNames04 = ["Gao", "Sua", "Thuoc cam", "Ao khoac", "Sach giao khoa", "Nuoc sach", "Chan am"];
var shardBranches04 = branches04;
var contributions04 = [];

setupHashedShard04("contributions");

shardBranches04.forEach((branch, branchIndex) => {
  var campaignPool = campaigns04.filter((c) => String(c.branchId) === String(branch._id));
  var contributorPool = contributors04.filter((c) => String(c.branchId) === String(branch._id));

  for (var j = 0; j < 10; j += 1) {
    var n = (branchIndex * 10) + j + 1;
    var campaign = campaignPool[j % campaignPool.length];
    var contributor = contributorPool[j % contributorPool.length];
    var type = contributionTypes04[j % contributionTypes04.length];
    var status = contributionStatuses04[j % contributionStatuses04.length];
    var createdAt = new Date(2024, branchIndex, (j % 28) + 1);
    var doc = {
      _id: ObjectId(),
      branchId: branch._id,
      campaignId: campaign._id,
      contributorId: contributor._id,
      type,
      status,
      receivedAt: ["CONFIRMED", "RECEIVED"].includes(status) ? createdAt : undefined,
      createdBy: ObjectId(),
      contributorSnapshot: {
        fullName: contributor.fullName || contributor.name,
        organizationName: contributor.organizationName,
        phone: contributor.phone,
        email: contributor.email,
        type: contributor.type
      },
      campaignSnapshot: {
        code: campaign.code,
        title: campaign.title || campaign.name
      },
      branchSnapshot: {
        code: branch.code,
        name: branch.name
      },
      proofs: [{
        type: "RECEIPT",
        url: `https://example.com/proofs/contribution-${String(n).padStart(4, "0")}.pdf`,
        description: `Seed proof for contribution ${n}`,
        uploadedAt: createdAt
      }],
      createdAt,
      updatedAt: createdAt
    };

    if (type === "MONEY") {
      doc.moneyDetail = {
        amount: 100000 + (n * 25000),
        currency: "VND",
        paymentMethod: n % 2 === 0 ? "BANK_TRANSFER" : "CASH",
        paymentStatus: status === "REJECTED" ? "FAILED" : "SUCCESS",
        transactionCode: `TXN-${branch.code}-${String(j + 1).padStart(4, "0")}`,
        paidAt: createdAt
      };
    } else if (type === "SERVICE") {
      doc.serviceDetail = {
        serviceName: `Dich vu ho tro ${j + 1}`,
        provider: contributor.organizationName || contributor.fullName || contributor.name,
        estimatedHours: 2 + (j % 24),
        estimatedValue: 300000 + (j * 50000),
        note: "Seed service contribution"
      };
    } else if (type === "VOLUNTEER_WORK") {
      doc.volunteerWorkDetail = {
        skill: ["Van chuyen", "Y te", "Day hoc", "To chuc su kien"][j % 4],
        hours: 2 + (j % 10),
        workDate: createdAt,
        description: "Seed volunteer work"
      };
    } else {
      doc.itemDetails = [{
        name: itemNames04[j % itemNames04.length],
        category: type,
        quantity: 1 + (j % 30),
        unit: j % 2 === 0 ? "phan" : "thung",
        condition: "NEW",
        estimatedValue: 50000 + (j * 10000),
        note: "Seed item contribution"
      }];
    }

    contributions04.push(doc);
  }
});

db.contributions.insertMany(contributions04, { ordered: false });
moveBranchChunks04("contributions", shardBranches04, ["shard1RS", "shard2RS", "shard3RS", "shard4RS", "shard5RS"]);
print(`OK contributions inserted: ${db.contributions.countDocuments()}`);
print("Expected total: 50 = 10 records x 5 branches");
db.contributions.aggregate([{ $group: { _id: "$branchSnapshot.code", count: { $sum: 1 } } }, { $sort: { _id: 1 } }]).forEach(printjson);
print("Shard key: { branchId: \"hashed\" }. Physical shard counts can differ with small demo data; verify logical branch counts above through mongos.");
print("Run: db.contributions.getShardDistribution()");
