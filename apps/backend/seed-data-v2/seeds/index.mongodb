// ============= SEED DATA INDEX - COPY/PASTE DIRECTLY INTO MONGOSH =============
// Aligned with Baocao.tex, mermail.html, 16-thiet-ke-csdl-mongodb.md and 08 guide.
// Model: May 1 controller in Ha Noi; May 2-6 are 5 shard replica sets.
// Ha Noi is controller/mongos only, so seed data has 5 branch records.
// Sharded demo collections: contributions, aid_distributions, activity_logs by range { branchId: 1 }.
// Configure sharding first in huong-dan/08-tich-hop-be-fe-6-may.md, then run this seed.

db = db.getSiblingDB("charity_distributed");
print("Seed data v2 starting...");

var seedCollections = [
  "stats_snapshots",
  "volunteers",
  "users",
  "beneficiaries",
  "contributors",
  "campaigns",
  "branches"
];
seedCollections.forEach((name) => db.getCollection(name).drop());

db.contributions.deleteMany({});
db.aid_distributions.deleteMany({});
db.activity_logs.deleteMany({});

var branches = [
  { _id: ObjectId("660000000000000000000002"), name: "Chi nhanh Hai Phong", code: "HP-S1", type: "BRANCH", province: "Hai Phong", district: "Hong Bang", ward: "So Dau", address: "May 2 - shard1RS", phone: "0225100002", email: "haiphong@charity.local", status: "ACTIVE", createdAt: new Date("2024-01-02T00:00:00Z"), updatedAt: new Date("2024-01-02T00:00:00Z") },
  { _id: ObjectId("660000000000000000000003"), name: "Chi nhanh Thanh Hoa", code: "TH-S2", type: "BRANCH", province: "Thanh Hoa", district: "Thanh Hoa", ward: "Lam Son", address: "May 3 - shard2RS", phone: "0237100003", email: "thanhhoa@charity.local", status: "ACTIVE", createdAt: new Date("2024-01-03T00:00:00Z"), updatedAt: new Date("2024-01-03T00:00:00Z") },
  { _id: ObjectId("660000000000000000000004"), name: "Chi nhanh Da Nang", code: "DN-S3", type: "BRANCH", province: "Da Nang", district: "Hai Chau", ward: "Thach Thang", address: "May 4 - shard3RS", phone: "0236100004", email: "danang@charity.local", status: "ACTIVE", createdAt: new Date("2024-01-04T00:00:00Z"), updatedAt: new Date("2024-01-04T00:00:00Z") },
  { _id: ObjectId("660000000000000000000005"), name: "Chi nhanh Ho Chi Minh", code: "HCM-S4", type: "BRANCH", province: "Ho Chi Minh", district: "Quan 1", ward: "Ben Nghe", address: "May 5 - shard4RS", phone: "0281000005", email: "hochiminh@charity.local", status: "ACTIVE", createdAt: new Date("2024-01-05T00:00:00Z"), updatedAt: new Date("2024-01-05T00:00:00Z") },
  { _id: ObjectId("660000000000000000000006"), name: "Chi nhanh Ben Tre", code: "BT-S5", type: "BRANCH", province: "Ben Tre", district: "Ben Tre", ward: "Phu Khuong", address: "May 6 - shard5RS", phone: "0275100006", email: "bentre@charity.local", status: "ACTIVE", createdAt: new Date("2024-01-06T00:00:00Z"), updatedAt: new Date("2024-01-06T00:00:00Z") }
];
db.branches.insertMany(branches, { ordered: false });

var campaignTypes = ["FLOOD_RELIEF", "SCHOLARSHIP", "MEDICAL_SUPPORT", "FOOD_SUPPORT", "CHILD_SUPPORT", "DISASTER_RELIEF"];
var campaignStatuses = ["ACTIVE", "ACTIVE", "COMPLETED", "PAUSED", "DRAFT"];
var resourceNames = ["Tien mat", "Gao", "Thuoc", "Sach vo", "Quan ao", "Gio cong tinh nguyen"];
var campaigns = [];
branches.forEach((branch, branchIndex) => {
  for (var j = 0; j < 2; j += 1) {
    var startDate = new Date(2024, j % 12, (j * 2) + 1);
    var endDate = new Date(2024, (j % 12) + 1, (j * 2) + 8);
    var targetAmount = 50000000 + (((branchIndex * 2) + j + 1) * 3000000);
    var currentAmount = Math.floor(targetAmount * (0.35 + ((j % 5) * 0.09)));
    var disbursedAmount = Math.floor(currentAmount * (0.25 + ((j % 4) * 0.1)));
    campaigns.push({
      _id: ObjectId(),
      branchId: branch._id,
      code: `${branch.code}-CMP-${String(j + 1).padStart(2, "0")}`,
      name: `Chien dich ${resourceNames[j % resourceNames.length]} - ${branch.province}`,
      title: `Chien dich ${resourceNames[j % resourceNames.length]} - ${branch.province}`,
      description: `Chien dich mau cua ${branch.name}, dung cho demo dashboard va shard theo branchId.`,
      type: campaignTypes[j % campaignTypes.length],
      status: campaignStatuses[j % campaignStatuses.length],
      visibility: j % 5 === 0 ? "INTERNAL" : "PUBLIC",
      targetAmount,
      currentAmount,
      disbursedAmount,
      startDate,
      endDate,
      timeRange: { startDate, endDate },
      location: { province: branch.province, district: branch.district, ward: branch.ward, address: branch.address },
      goals: { targetMoneyAmount: targetAmount, targetItemSummary: resourceNames.slice(0, (j % resourceNames.length) + 1).join(", "), targetVolunteerCount: 20 + (j * 5) },
      requiredResources: [{ resourceType: j % 3 === 0 ? "MONEY" : "ITEM", name: resourceNames[j % resourceNames.length], quantity: 10 + (j * 3), unit: j % 3 === 0 ? "trieu VND" : "phan", estimatedValue: 1000000 + (j * 500000) }],
      summaryStats: { totalMoneyReceived: currentAmount, totalEstimatedItemValue: 2000000 + (j * 750000), totalVolunteerHours: 30 + (j * 8), totalMoneyDistributed: disbursedAmount, totalEstimatedAidValue: 1000000 + (j * 550000), beneficiaryCount: 5 + (j * 2) },
      createdBy: ObjectId(),
      organizerId: ObjectId(),
      images: [],
      proofImages: [],
      documents: [],
      metadata: { seedBatch: "seed-data-v2", branchCode: branch.code, physicalRole: branch.address },
      createdAt: startDate,
      updatedAt: new Date(2024, (j % 12) + 1, (j * 2) + 10)
    });
  }
});
db.campaigns.insertMany(campaigns, { ordered: false });

var contributorTypes = ["INDIVIDUAL", "ORGANIZATION", "SERVICE_PROVIDER"];
var contributors = [];
branches.forEach((branch, branchIndex) => {
  for (var j = 0; j < 3; j += 1) {
    var n = (branchIndex * 3) + j + 1;
    var type = contributorTypes[j % contributorTypes.length];
    var fullName = type === "INDIVIDUAL" ? `Nguoi dong gop ${String(n).padStart(3, "0")} ${branch.province}` : `To chuc ho tro ${String(n).padStart(3, "0")} ${branch.province}`;
    contributors.push({
      _id: ObjectId(),
      branchId: branch._id,
      type,
      name: fullName,
      fullName,
      organizationName: type === "INDIVIDUAL" ? undefined : fullName,
      email: `contributor${String(n).padStart(3, "0")}@example.com`,
      phone: `08${String(20000000 + n).slice(-8)}`,
      address: { street: `${200 + n} Duong Dong Gop`, district: branch.district, province: branch.province, country: "Viet Nam" },
      totalContributionStats: { moneyCount: j % 6, totalMoneyAmount: (j + 1) * 1000000, itemCount: j % 5, totalEstimatedItemValue: (j + 1) * 400000, serviceCount: type === "SERVICE_PROVIDER" ? (j % 4) + 1 : 0, totalServiceValue: type === "SERVICE_PROVIDER" ? (j + 1) * 700000 : 0, volunteerCount: j % 4, totalVolunteerHours: (j % 4) * 6 },
      isActive: j !== 9,
      createdAt: new Date(2024, branchIndex, j + 1),
      updatedAt: new Date(2024, branchIndex, j + 1)
    });
  }
});
db.contributors.insertMany(contributors, { ordered: false });

var demoPasswordHash = "$2a$12$QYQrB90EXt0HqEy5xQ.tmOnhLjNmPrflIbUuez0EZDGC0IXFFvq4.";
var users = [{
  _id: ObjectId(),
  email: "superadmin@charity.local",
  password: demoPasswordHash,
  fullName: "Super Admin",
  role: "SUPER_ADMIN",
  permissions: ["system:read", "system:write", "branches:manage"],
  isActive: true,
  createdAt: new Date("2024-01-01T00:00:00Z"),
  updatedAt: new Date("2024-01-01T00:00:00Z")
}];
branches.forEach((branch, i) => {
  users.push({ _id: ObjectId(), email: `${branch.code.toLowerCase()}.admin@charity.local`, phone: `086${String(1000000 + i).slice(-7)}`, password: demoPasswordHash, fullName: `Quan tri ${branch.province}`, role: "BRANCH_ADMIN", branchId: branch._id, permissions: ["campaigns:write", "contributions:write", "aid:write", "reports:read"], isActive: true, createdAt: new Date(2024, i, 1), updatedAt: new Date(2024, i, 1) });
  users.push({ _id: ObjectId(), email: `${branch.code.toLowerCase()}.staff@charity.local`, phone: `087${String(1000000 + i).slice(-7)}`, password: demoPasswordHash, fullName: `Nhan vien ${branch.province}`, role: "STAFF", branchId: branch._id, permissions: ["campaigns:read", "contributions:write", "aid:write"], isActive: true, createdAt: new Date(2024, i, 2), updatedAt: new Date(2024, i, 2) });
});
db.users.insertMany(users, { ordered: false });

var skills = ["logistics", "medical-support", "education", "warehouse", "transport", "field-survey"];
var volunteers = [];
branches.forEach((branch, branchIndex) => {
  var campaignPool = campaigns.filter((campaign) => String(campaign.branchId) === String(branch._id));
  for (var j = 0; j < 3; j += 1) {
    var n = (branchIndex * 3) + j + 1;
    volunteers.push({ _id: ObjectId(), branchId: branch._id, fullName: `Tinh nguyen vien ${String(n).padStart(3, "0")} - ${branch.province}`, phone: `089${String(2000000 + n).slice(-7)}`, email: `volunteer${String(n).padStart(3, "0")}@example.com`, skills: [skills[j % skills.length], skills[(j + 2) % skills.length]], joinedCampaignIds: campaignPool.slice(0, 2).map((campaign) => campaign._id), status: j === 7 ? "INACTIVE" : "ACTIVE", createdAt: new Date(2024, branchIndex, j + 1), updatedAt: new Date(2024, branchIndex, j + 1) });
  }
});
db.volunteers.insertMany(volunteers, { ordered: false });

var shardBranches = branches;
var contributionTypes = ["MONEY", "ITEM", "MEDICINE", "CLOTHES", "BOOK", "SERVICE", "VOLUNTEER_WORK"];
var contributionStatuses = ["PENDING", "CONFIRMED", "RECEIVED", "RECEIVED", "REJECTED"];
var itemNames = ["Gao", "Sua", "Thuoc cam", "Ao khoac", "Sach giao khoa", "Nuoc sach", "Chan am"];
var contributions = [];
shardBranches.forEach((branch, branchIndex) => {
  var campaignPool = campaigns.filter((c) => String(c.branchId) === String(branch._id));
  var contributorPool = contributors.filter((c) => String(c.branchId) === String(branch._id));
  for (var j = 0; j < 10; j += 1) {
    var n = (branchIndex * 10) + j + 1;
    var campaign = campaignPool[j % campaignPool.length];
    var contributor = contributorPool[j % contributorPool.length];
    var type = contributionTypes[j % contributionTypes.length];
    var status = contributionStatuses[j % contributionStatuses.length];
    var createdAt = new Date(2024, branchIndex, (j % 28) + 1);
    var doc = {
      _id: ObjectId(),
      branchId: branch._id,
      campaignId: campaign._id,
      contributorId: contributor._id,
      type,
      status,
      receivedAt: ["CONFIRMED", "RECEIVED"].includes(status) ? createdAt : undefined,
      createdBy: ObjectId(),
      contributorSnapshot: { fullName: contributor.fullName || contributor.name, organizationName: contributor.organizationName, phone: contributor.phone, email: contributor.email, type: contributor.type },
      campaignSnapshot: { code: campaign.code, title: campaign.title || campaign.name },
      branchSnapshot: { code: branch.code, name: branch.name },
      proofs: [{ type: "RECEIPT", url: `https://example.com/proofs/contribution-${String(n).padStart(4, "0")}.pdf`, uploadedAt: createdAt }],
      createdAt,
      updatedAt: createdAt
    };
    if (type === "MONEY") {
      doc.moneyDetail = { amount: 100000 + (n * 25000), currency: "VND", paymentMethod: n % 2 === 0 ? "BANK_TRANSFER" : "CASH", paymentStatus: status === "REJECTED" ? "FAILED" : "SUCCESS", transactionCode: `TXN-${branch.code}-${String(j + 1).padStart(4, "0")}`, paidAt: createdAt };
    } else if (type === "SERVICE") {
      doc.serviceDetail = { serviceName: `Dich vu ho tro ${j + 1}`, provider: contributor.organizationName || contributor.fullName || contributor.name, estimatedHours: 2 + (j % 24), estimatedValue: 300000 + (j * 50000), note: "Seed service contribution" };
    } else if (type === "VOLUNTEER_WORK") {
      doc.volunteerWorkDetail = { skill: ["Van chuyen", "Y te", "Day hoc", "To chuc su kien"][j % 4], hours: 2 + (j % 10), workDate: createdAt, description: "Seed volunteer work" };
    } else {
      doc.itemDetails = [{ name: itemNames[j % itemNames.length], category: type, quantity: 1 + (j % 30), unit: j % 2 === 0 ? "phan" : "thung", condition: "NEW", estimatedValue: 50000 + (j * 10000), note: "Seed item contribution" }];
    }
    contributions.push(doc);
  }
});
db.contributions.insertMany(contributions, { ordered: false });

var beneficiaryTypes = ["INDIVIDUAL", "FAMILY", "ORGANIZATION", "COMMUNITY"];
var verificationStatuses = ["PENDING", "VERIFIED", "VERIFIED", "REJECTED"];
var reasons = ["POVERTY", "DISABILITY", "ELDERLY_ALONE", "SOCIAL_WELFARE", "DISASTER_AFFECTED"];
var beneficiaries = [];
shardBranches.forEach((branch, branchIndex) => {
  var campaignPool = campaigns.filter((c) => String(c.branchId) === String(branch._id));
  for (var j = 0; j < 4; j += 1) {
    var n = (branchIndex * 4) + j + 1;
    var campaign = campaignPool[j % campaignPool.length];
    var type = beneficiaryTypes[j % beneficiaryTypes.length];
    var verificationStatus = verificationStatuses[j % verificationStatuses.length];
    beneficiaries.push({
      _id: ObjectId(),
      branchId: branch._id,
      campaignId: campaign._id,
      name: `${type === "FAMILY" ? "Gia dinh" : "Nguoi nhan ho tro"} ${String(n).padStart(3, "0")} - ${branch.province}`,
      type,
      email: `beneficiary${String(n).padStart(3, "0")}@example.com`,
      phone: `07${String(30000000 + n).slice(-8)}`,
      address: { street: `${300 + n} Duong Ho Tro`, district: branch.district, province: branch.province, country: "Viet Nam" },
      location: { province: branch.province, district: branch.district, ward: branch.ward, address: `${300 + n} Duong Ho Tro` },
      householdSize: 1 + (j % 8),
      incomeLevel: j % 3 === 0 ? "VERY_LOW" : "LOW",
      reason: reasons[j % reasons.length],
      healthIssues: j % 4 === 0 ? ["Benh nen"] : [],
      education: ["ILLITERATE", "PRIMARY_SCHOOL", "SECONDARY_SCHOOL", "HIGH_SCHOOL"][j % 4],
      employment: ["UNEMPLOYED", "INFORMAL_JOB", "FARMER", "RETIRED"][j % 4],
      children: j % 5,
      children_ages: Array.from({ length: j % 5 }, (_, k) => 4 + k + (j % 6)),
      situationDescription: `Seed beneficiary ${n} in ${branch.province}.`,
      verificationStatus,
      verifiedBy: verificationStatus === "VERIFIED" ? ObjectId() : undefined,
      verifiedAt: verificationStatus === "VERIFIED" ? new Date(2024, branchIndex, (j % 28) + 1) : undefined,
      status: verificationStatus === "REJECTED" ? "INACTIVE" : "ACTIVE",
      createdAt: new Date(2024, branchIndex, (j % 28) + 1),
      updatedAt: new Date(2024, branchIndex, (j % 28) + 1)
    });
  }
});
db.beneficiaries.insertMany(beneficiaries, { ordered: false });

var aidTypes = ["MONEY", "ITEM", "SERVICE", "MIXED"];
var aidStatuses = ["PENDING", "APPROVED", "DELIVERED", "COMPLETED", "COMPLETED", "REJECTED"];
var aidItems = ["Gao", "Sua", "Thuoc", "Sach vo", "Ao am", "Nuoc sach"];
var aids = [];
shardBranches.forEach((branch, branchIndex) => {
  var campaignPool = campaigns.filter((c) => String(c.branchId) === String(branch._id));
  var beneficiaryPool = beneficiaries.filter((b) => String(b.branchId) === String(branch._id));
  for (var j = 0; j < 5; j += 1) {
    var n = (branchIndex * 5) + j + 1;
    var campaign = campaignPool[j % campaignPool.length];
    var beneficiary = beneficiaryPool[j % beneficiaryPool.length];
    var type = aidTypes[j % aidTypes.length];
    var status = aidStatuses[j % aidStatuses.length];
    var createdAt = new Date(2024, branchIndex, (j % 28) + 1);
    var aidDoc = {
      _id: ObjectId(),
      branchId: branch._id,
      campaignId: campaign._id,
      beneficiaryId: beneficiary._id,
      type,
      status,
      approvedBy: ["APPROVED", "DELIVERED", "COMPLETED"].includes(status) ? ObjectId() : undefined,
      deliveredAt: ["DELIVERED", "COMPLETED"].includes(status) ? createdAt : undefined,
      completedAt: status === "COMPLETED" ? createdAt : undefined,
      createdBy: ObjectId(),
      beneficiarySnapshot: { name: beneficiary.name, type: beneficiary.type || "INDIVIDUAL", phone: beneficiary.phone, addressSummary: `${beneficiary.location?.district || branch.district}, ${beneficiary.location?.province || branch.province}` },
      campaignSnapshot: { code: campaign.code, title: campaign.title || campaign.name },
      branchSnapshot: { code: branch.code, name: branch.name },
      proofs: status === "COMPLETED" ? [{ type: "DELIVERY_RECEIPT", url: `https://example.com/proofs/aid-${String(n).padStart(4, "0")}.pdf`, uploadedAt: createdAt }] : [],
      note: `Seed aid distribution ${n}`,
      createdAt,
      updatedAt: createdAt
    };
    if (type === "MONEY" || type === "MIXED") {
      aidDoc.moneySupport = { amount: 200000 + (n * 30000), currency: "VND", method: n % 2 === 0 ? "BANK_TRANSFER" : "CASH" };
    }
    if (type === "ITEM" || type === "MIXED") {
      aidDoc.itemSupports = [{ name: aidItems[j % aidItems.length], category: "ESSENTIAL", quantity: 1 + (j % 20), unit: "phan", estimatedValue: 100000 + (j * 15000), note: "Seed item support" }];
    }
    if (type === "SERVICE") {
      aidDoc.serviceSupport = { serviceName: `Tu van va ho tro ${j + 1}`, provider: `Doi dich vu ${branch.code}`, estimatedHours: 1 + (j % 12), estimatedValue: 200000 + (j * 25000), note: "Seed service support" };
    }
    aids.push(aidDoc);
  }
});
db.aid_distributions.insertMany(aids, { ordered: false });

var actions = ["CAMPAIGN_CREATED", "CONTRIBUTION_RECEIVED", "CONTRIBUTION_CONFIRMED", "AID_DISTRIBUTION_APPROVED", "AID_DISTRIBUTION_DELIVERED", "BENEFICIARY_VERIFIED", "REPORT_VIEWED"];
var logs = [];
shardBranches.forEach((branch, branchIndex) => {
  var campaignPool = campaigns.filter((c) => String(c.branchId) === String(branch._id));
  var contributionPool = contributions.filter((c) => String(c.branchId) === String(branch._id));
  var aidPool = aids.filter((a) => String(a.branchId) === String(branch._id));
  for (var j = 0; j < 10; j += 1) {
    var n = (branchIndex * 10) + j + 1;
    var action = actions[j % actions.length];
    var campaign = campaignPool[j % campaignPool.length];
    var contribution = contributionPool[j % contributionPool.length];
    var aid = aidPool[j % aidPool.length];
    var entityType = "Campaign";
    var entityId = String(campaign._id);
    if (action.startsWith("CONTRIBUTION")) {
      entityType = "Contribution";
      entityId = String(contribution._id);
    }
    if (action.startsWith("AID")) {
      entityType = "AidDistribution";
      entityId = String(aid._id);
    }
    if (action.startsWith("BENEFICIARY")) {
      entityType = "Beneficiary";
      entityId = String(ObjectId());
    }
    logs.push({
      _id: ObjectId(),
      branchId: branch._id,
      targetBranchId: branch._id,
      actorId: ObjectId(),
      actorRole: j % 5 === 0 ? "BRANCH_ADMIN" : "STAFF",
      actorBranchId: branch._id,
      userId: ObjectId(),
      action,
      entityType,
      entityId,
      targetType: entityType,
      targetId: entityId,
      description: `Seed activity ${n}: ${action} at ${branch.code}`,
      before: { status: j % 2 === 0 ? "PENDING" : "DRAFT" },
      after: { status: j % 3 === 0 ? "COMPLETED" : "ACTIVE" },
      changes: { seedNo: n, branchCode: branch.code },
      ipAddress: `100.105.${branchIndex + 10}.${j + 10}`,
      userAgent: "mongosh-seed-data-v2",
      createdAt: new Date(2024, branchIndex, (j % 28) + 1)
    });
  }
});
db.activity_logs.insertMany(logs, { ordered: false });

var statsSnapshots = [];
branches.forEach((branch) => {
  var contributionMoney = db.contributions.aggregate([
    { $match: { branchId: branch._id, type: "MONEY", status: { $in: ["CONFIRMED", "RECEIVED"] } } },
    { $group: { _id: "$branchId", total: { $sum: "$moneyDetail.amount" }, count: { $sum: 1 } } }
  ]).toArray()[0] || { total: 0, count: 0 };
  var aidMoney = db.aid_distributions.aggregate([
    { $match: { branchId: branch._id, status: "COMPLETED" } },
    { $group: { _id: "$branchId", total: { $sum: "$moneySupport.amount" }, count: { $sum: 1 } } }
  ]).toArray()[0] || { total: 0, count: 0 };
  statsSnapshots.push({
    _id: ObjectId(),
    scopeType: "BRANCH",
    scopeKey: branch.code,
    branchId: branch._id,
    period: "2024-YTD",
    metrics: {
      campaignCount: db.campaigns.countDocuments({ branchId: branch._id }),
      activeCampaignCount: db.campaigns.countDocuments({ branchId: branch._id, status: "ACTIVE" }),
      contributionCount: db.contributions.countDocuments({ branchId: branch._id }),
      receivedMoney: contributionMoney.total,
      beneficiaryCount: db.beneficiaries.countDocuments({ branchId: branch._id }),
      aidDistributionCount: db.aid_distributions.countDocuments({ branchId: branch._id }),
      completedAidCount: aidMoney.count,
      distributedMoney: aidMoney.total,
      activityLogCount: db.activity_logs.countDocuments({ branchId: branch._id })
    },
    generatedAt: new Date("2024-12-31T23:59:59Z"),
    createdAt: new Date("2024-12-31T23:59:59Z"),
    updatedAt: new Date("2024-12-31T23:59:59Z")
  });
});
db.stats_snapshots.insertMany(statsSnapshots, { ordered: false });

print("");
print("Seed data v2 completed.");
print(`branches: ${db.branches.countDocuments()}`);
print(`users: ${db.users.countDocuments()}`);
print(`campaigns: ${db.campaigns.countDocuments()}`);
print(`contributors: ${db.contributors.countDocuments()}`);
print(`contributions: ${db.contributions.countDocuments()}`);
print(`beneficiaries: ${db.beneficiaries.countDocuments()}`);
print(`aid_distributions: ${db.aid_distributions.countDocuments()}`);
print(`volunteers: ${db.volunteers.countDocuments()}`);
print(`activity_logs: ${db.activity_logs.countDocuments()}`);
print(`stats_snapshots: ${db.stats_snapshots.countDocuments()}`);
print("");
print("Expected compact demo counts:");
print("branches=5, users=11, campaigns=10, contributors=15, contributions=50, beneficiaries=20, aid_distributions=25, volunteers=15, activity_logs=50, stats_snapshots=5");
print("");
print("Branch-level counts for sharded collections:");
db.contributions.aggregate([{ $group: { _id: "$branchSnapshot.code", count: { $sum: 1 } } }, { $sort: { _id: 1 } }]).forEach((row) => print(`contributions ${row._id}: ${row.count}`));
db.aid_distributions.aggregate([{ $group: { _id: "$branchSnapshot.code", count: { $sum: 1 } } }, { $sort: { _id: 1 } }]).forEach((row) => print(`aid_distributions ${row._id}: ${row.count}`));
db.activity_logs.aggregate([{ $group: { _id: "$changes.branchCode", count: { $sum: 1 } } }, { $sort: { _id: 1 } }]).forEach((row) => print(`activity_logs ${row._id}: ${row.count}`));
print("");
print("Shard key for hot collections: { branchId: 1 } with zone ranges");
print("Expected placement: HP-S1->shard1RS, TH-S2->shard2RS, DN-S3->shard3RS, HCM-S4->shard4RS, BT-S5->shard5RS.");
print("");
print("Check distribution:");
print("db.contributions.getShardDistribution()");
print("db.aid_distributions.getShardDistribution()");
print("db.activity_logs.getShardDistribution()");
