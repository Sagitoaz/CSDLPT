// ============= SEED DATA INDEX - COPY/PASTE DIRECTLY INTO MONGOSH =============
// Paste this whole file into mongosh connected to mongos on May 1.
// It does not use load(). It resets seed collections, prepares hashed sharding
// for the high-growth collections, then inserts enough data to spread by branchId.

db = db.getSiblingDB("charity_distributed");

print("Seed data v2 starting...");

const collections = [
  "activity_logs",
  "aid_distributions",
  "beneficiaries",
  "contributions",
  "contributors",
  "campaigns",
  "branches"
];

collections.forEach((name) => {
  db.getCollection(name).drop();
});

function tryShardCollection(name) {
  try {
    if (typeof sh === "undefined") {
      print(`Skip sharding ${name}: not connected through mongos.`);
      return;
    }
    sh.enableSharding("charity_distributed");
    try {
      sh.shardCollection(`charity_distributed.${name}`, { branchId: "hashed" }, false, { numInitialChunks: 50 });
    } catch (errWithOptions) {
      sh.shardCollection(`charity_distributed.${name}`, { branchId: "hashed" });
    }
    print(`Sharded ${name} with branchId hashed and initial chunks.`);
  } catch (err) {
    print(`Shard setup for ${name}: ${err.message}`);
  }
}

["contributions", "aid_distributions", "activity_logs"].forEach(tryShardCollection);

const provinces = [
  "Ha Noi", "TP Ho Chi Minh", "Da Nang", "Hai Phong", "Can Tho",
  "Hue", "Nghe An", "Thanh Hoa", "Binh Dinh", "Khanh Hoa",
  "Dak Lak", "Lam Dong", "Dong Nai", "Binh Duong", "An Giang",
  "Kien Giang", "Ca Mau", "Quang Ninh", "Thai Nguyen", "Lao Cai"
];

const branches = Array.from({ length: 60 }, (_, i) => {
  const n = i + 1;
  const province = provinces[i % provinces.length];
  return {
    _id: ObjectId(),
    name: n === 1 ? "Trung tam tu thien trung uong" : `Chi nhanh ${String(n).padStart(2, "0")} - ${province}`,
    code: n === 1 ? "HQ" : `BR${String(n).padStart(2, "0")}`,
    type: n === 1 ? "HEADQUARTER" : (n % 10 === 0 ? "REGIONAL_CENTER" : "BRANCH"),
    province,
    district: `Quan/Huyen ${((i % 12) + 1)}`,
    ward: `Phuong/Xa ${((i % 20) + 1)}`,
    address: `${100 + n} Duong Tu Thien, ${province}`,
    phone: `09${String(10000000 + n).slice(-8)}`,
    email: n === 1 ? "hq@charity.local" : `branch${String(n).padStart(2, "0")}@charity.local`,
    status: "ACTIVE",
    createdAt: new Date(2024, 0, (i % 28) + 1),
    updatedAt: new Date(2024, 1, (i % 28) + 1)
  };
});
db.branches.insertMany(branches, { ordered: false });

const campaignTypes = ["FLOOD_RELIEF", "SCHOLARSHIP", "MEDICAL_SUPPORT", "FOOD_SUPPORT", "CHILD_SUPPORT", "DISASTER_RELIEF", "OTHER"];
const campaignStatuses = ["ACTIVE", "ACTIVE", "COMPLETED", "PAUSED", "DRAFT"];
const campaigns = Array.from({ length: 90 }, (_, i) => {
  const n = i + 1;
  const branch = branches[i % branches.length];
  const targetAmount = 30000000 + (n * 2500000);
  const currentAmount = Math.floor(targetAmount * (0.35 + ((i % 8) * 0.06)));
  const disbursedAmount = Math.floor(currentAmount * (0.25 + ((i % 5) * 0.08)));
  const startDate = new Date(2024, i % 12, (i % 20) + 1);
  const endDate = new Date(2024, (i % 12) + 1, (i % 20) + 8);
  return {
    _id: ObjectId(),
    branchId: branch._id,
    code: `CMP${String(n).padStart(4, "0")}`,
    name: `Chien dich ${String(n).padStart(3, "0")} - ${branch.province}`,
    title: `Chien dich ${String(n).padStart(3, "0")} - ${branch.province}`,
    description: `Seed campaign ${n} for distributed MongoDB shard testing.`,
    type: campaignTypes[i % campaignTypes.length],
    status: campaignStatuses[i % campaignStatuses.length],
    visibility: i % 6 === 0 ? "INTERNAL" : "PUBLIC",
    targetAmount,
    currentAmount,
    disbursedAmount,
    startDate,
    endDate,
    timeRange: { startDate, endDate },
    location: { province: branch.province, district: branch.district, ward: branch.ward, address: branch.address },
    goals: {
      targetMoneyAmount: targetAmount,
      targetItemSummary: "Tien mat, gao, thuoc, sach vo, quan ao",
      targetVolunteerCount: 10 + (i % 70)
    },
    requiredResources: [{
      resourceType: i % 3 === 0 ? "MONEY" : "ITEM",
      name: i % 3 === 0 ? "Tien mat" : "Nhu yeu pham",
      quantity: 10 + (i % 40),
      unit: i % 3 === 0 ? "trieu VND" : "phan",
      estimatedValue: 1000000 + (i * 150000)
    }],
    summaryStats: {
      totalMoneyReceived: currentAmount,
      totalEstimatedItemValue: 500000 + (i * 120000),
      totalVolunteerHours: 20 + (i % 90),
      totalMoneyDistributed: disbursedAmount,
      totalEstimatedAidValue: 300000 + (i * 90000),
      beneficiaryCount: 3 + (i % 35)
    },
    createdBy: ObjectId(),
    organizerId: ObjectId(),
    images: [],
    proofImages: [],
    documents: [],
    metadata: { seedBatch: "seed-data-v2", branchCode: branch.code },
    createdAt: startDate,
    updatedAt: new Date(2024, (i % 12) + 1, (i % 20) + 10)
  };
});
db.campaigns.insertMany(campaigns, { ordered: false });

const contributorTypes = ["INDIVIDUAL", "ORGANIZATION", "SERVICE_PROVIDER"];
const contributors = Array.from({ length: 120 }, (_, i) => {
  const n = i + 1;
  const branch = branches[(i * 7) % branches.length];
  const type = contributorTypes[i % contributorTypes.length];
  const fullName = type === "INDIVIDUAL" ? `Nguoi dong gop ${String(n).padStart(3, "0")}` : `To chuc thien nguyen ${String(n).padStart(3, "0")}`;
  return {
    _id: ObjectId(),
    branchId: branch._id,
    type,
    name: fullName,
    fullName,
    organizationName: type === "INDIVIDUAL" ? undefined : fullName,
    email: `contributor${String(n).padStart(3, "0")}@example.com`,
    phone: `08${String(20000000 + n).slice(-8)}`,
    address: { street: `${200 + n} Duong Dong Gop`, district: branch.district, province: branch.province, country: "Viet Nam" },
    totalContributionStats: {
      moneyCount: i % 9,
      totalMoneyAmount: (i + 1) * 750000,
      itemCount: i % 7,
      totalEstimatedItemValue: (i + 1) * 250000,
      serviceCount: type === "SERVICE_PROVIDER" ? (i % 5) + 1 : 0,
      totalServiceValue: type === "SERVICE_PROVIDER" ? (i + 1) * 500000 : 0,
      volunteerCount: i % 6,
      totalVolunteerHours: (i % 6) * 4
    },
    isActive: i % 17 !== 0,
    createdAt: new Date(2024, i % 12, (i % 28) + 1),
    updatedAt: new Date(2024, i % 12, (i % 28) + 1)
  };
});
db.contributors.insertMany(contributors, { ordered: false });

const contributionTypes = ["MONEY", "ITEM", "MEDICINE", "CLOTHES", "BOOK", "SERVICE", "VOLUNTEER_WORK"];
const contributionStatuses = ["PENDING", "CONFIRMED", "RECEIVED", "RECEIVED", "REJECTED"];
const itemNames = ["Gao", "Sua", "Thuoc cam", "Ao khoac", "Sach giao khoa", "Nuoc sach", "Chan am"];
const contributions = Array.from({ length: 220 }, (_, i) => {
  const n = i + 1;
  const branch = branches[(i * 11) % branches.length];
  const campaignPool = campaigns.filter(c => String(c.branchId) === String(branch._id));
  const campaign = campaignPool.length ? campaignPool[i % campaignPool.length] : campaigns[i % campaigns.length];
  const contributor = contributors[(i * 13) % contributors.length];
  const type = contributionTypes[i % contributionTypes.length];
  const status = contributionStatuses[i % contributionStatuses.length];
  const createdAt = new Date(2024, i % 12, (i % 28) + 1);
  const doc = {
    _id: ObjectId(),
    branchId: branch._id,
    campaignId: campaign._id,
    contributorId: contributor._id,
    type,
    status,
    receivedAt: ["CONFIRMED", "RECEIVED"].includes(status) ? createdAt : undefined,
    createdBy: ObjectId(),
    contributorSnapshot: {
      fullName: contributor.fullName || contributor.name,
      organizationName: contributor.organizationName,
      phone: contributor.phone,
      email: contributor.email,
      type: contributor.type
    },
    campaignSnapshot: { code: campaign.code, title: campaign.title || campaign.name },
    branchSnapshot: { code: branch.code, name: branch.name },
    proofs: [{ type: "RECEIPT", url: `https://example.com/proofs/contribution-${String(n).padStart(4, "0")}.pdf`, uploadedAt: createdAt }],
    createdAt,
    updatedAt: createdAt
  };
  if (type === "MONEY") {
    doc.moneyDetail = { amount: 100000 + (n * 50000), currency: "VND", paymentMethod: n % 2 === 0 ? "BANK_TRANSFER" : "CASH", paymentStatus: status === "REJECTED" ? "FAILED" : "SUCCESS", transactionCode: `TXN-SEED-${String(n).padStart(5, "0")}`, paidAt: createdAt };
  } else if (type === "SERVICE") {
    doc.serviceDetail = { serviceName: `Dich vu ho tro ${n}`, provider: contributor.organizationName || contributor.fullName || contributor.name, estimatedHours: 2 + (i % 24), estimatedValue: 300000 + (i * 50000), note: "Seed service contribution" };
  } else if (type === "VOLUNTEER_WORK") {
    doc.volunteerWorkDetail = { skill: ["Van chuyen", "Y te", "Day hoc", "To chuc su kien"][i % 4], hours: 2 + (i % 10), workDate: createdAt, description: "Seed volunteer work" };
  } else {
    doc.itemDetails = [{ name: itemNames[i % itemNames.length], category: type, quantity: 1 + (i % 30), unit: i % 2 === 0 ? "phan" : "thung", condition: "NEW", estimatedValue: 50000 + (i * 10000), note: "Seed item contribution" }];
  }
  return doc;
});
db.contributions.insertMany(contributions, { ordered: false });

const beneficiaryTypes = ["INDIVIDUAL", "FAMILY", "ORGANIZATION", "COMMUNITY"];
const verificationStatuses = ["PENDING", "VERIFIED", "VERIFIED", "REJECTED"];
const reasons = ["POVERTY", "DISABILITY", "ELDERLY_ALONE", "SOCIAL_WELFARE", "DISASTER_AFFECTED"];
const beneficiaries = Array.from({ length: 140 }, (_, i) => {
  const n = i + 1;
  const branch = branches[(i * 5) % branches.length];
  const campaignPool = campaigns.filter(c => String(c.branchId) === String(branch._id));
  const campaign = campaignPool.length ? campaignPool[i % campaignPool.length] : campaigns[i % campaigns.length];
  const type = beneficiaryTypes[i % beneficiaryTypes.length];
  const verificationStatus = verificationStatuses[i % verificationStatuses.length];
  return {
    _id: ObjectId(),
    branchId: branch._id,
    campaignId: campaign._id,
    name: `${type === "FAMILY" ? "Gia dinh" : "Nguoi nhan ho tro"} ${String(n).padStart(3, "0")}`,
    type,
    email: `beneficiary${String(n).padStart(3, "0")}@example.com`,
    phone: `07${String(30000000 + n).slice(-8)}`,
    address: { street: `${300 + n} Duong Ho Tro`, district: branch.district, province: branch.province, country: "Viet Nam" },
    location: { province: branch.province, district: branch.district, ward: branch.ward, address: `${300 + n} Duong Ho Tro` },
    householdSize: 1 + (i % 8),
    incomeLevel: i % 3 === 0 ? "VERY_LOW" : "LOW",
    reason: reasons[i % reasons.length],
    healthIssues: i % 4 === 0 ? ["Benh nen"] : [],
    education: ["ILLITERATE", "PRIMARY_SCHOOL", "SECONDARY_SCHOOL", "HIGH_SCHOOL"][i % 4],
    employment: ["UNEMPLOYED", "INFORMAL_JOB", "FARMER", "RETIRED"][i % 4],
    children: i % 5,
    children_ages: Array.from({ length: i % 5 }, (_, k) => 4 + k + (i % 6)),
    situationDescription: `Seed beneficiary ${n} in ${branch.province}.`,
    verificationStatus,
    verifiedBy: verificationStatus === "VERIFIED" ? ObjectId() : undefined,
    verifiedAt: verificationStatus === "VERIFIED" ? new Date(2024, i % 12, (i % 28) + 1) : undefined,
    status: verificationStatus === "REJECTED" ? "INACTIVE" : "ACTIVE",
    createdAt: new Date(2024, i % 12, (i % 28) + 1),
    updatedAt: new Date(2024, i % 12, (i % 28) + 1)
  };
});
db.beneficiaries.insertMany(beneficiaries, { ordered: false });

const aidTypes = ["MONEY", "ITEM", "SERVICE", "MIXED"];
const aidStatuses = ["PENDING", "APPROVED", "DELIVERED", "COMPLETED", "COMPLETED", "REJECTED"];
const aidItems = ["Gao", "Sua", "Thuoc", "Sach vo", "Ao am", "Nuoc sach"];
const aids = Array.from({ length: 180 }, (_, i) => {
  const n = i + 1;
  const branch = branches[(i * 17) % branches.length];
  const campaignPool = campaigns.filter(c => String(c.branchId) === String(branch._id));
  const beneficiaryPool = beneficiaries.filter(b => String(b.branchId) === String(branch._id));
  const campaign = campaignPool.length ? campaignPool[i % campaignPool.length] : campaigns[i % campaigns.length];
  const beneficiary = beneficiaryPool.length ? beneficiaryPool[i % beneficiaryPool.length] : beneficiaries[i % beneficiaries.length];
  const type = aidTypes[i % aidTypes.length];
  const status = aidStatuses[i % aidStatuses.length];
  const createdAt = new Date(2024, i % 12, (i % 28) + 1);
  const doc = {
    _id: ObjectId(),
    branchId: branch._id,
    campaignId: campaign._id,
    beneficiaryId: beneficiary._id,
    type,
    status,
    approvedBy: ["APPROVED", "DELIVERED", "COMPLETED"].includes(status) ? ObjectId() : undefined,
    deliveredAt: ["DELIVERED", "COMPLETED"].includes(status) ? createdAt : undefined,
    completedAt: status === "COMPLETED" ? createdAt : undefined,
    createdBy: ObjectId(),
    beneficiarySnapshot: { name: beneficiary.name, type: beneficiary.type || "INDIVIDUAL", phone: beneficiary.phone, addressSummary: `${beneficiary.location?.district || branch.district}, ${beneficiary.location?.province || branch.province}` },
    campaignSnapshot: { code: campaign.code, title: campaign.title || campaign.name },
    branchSnapshot: { code: branch.code, name: branch.name },
    proofs: status === "COMPLETED" ? [{ type: "DELIVERY_RECEIPT", url: `https://example.com/proofs/aid-${String(n).padStart(4, "0")}.pdf`, uploadedAt: createdAt }] : [],
    note: `Seed aid distribution ${n}`,
    createdAt,
    updatedAt: createdAt
  };
  if (type === "MONEY" || type === "MIXED") {
    doc.moneySupport = { amount: 200000 + (n * 40000), currency: "VND", method: n % 2 === 0 ? "BANK_TRANSFER" : "CASH" };
  }
  if (type === "ITEM" || type === "MIXED") {
    doc.itemSupports = [{ name: aidItems[i % aidItems.length], category: "ESSENTIAL", quantity: 1 + (i % 20), unit: "phan", estimatedValue: 100000 + (i * 15000), note: "Seed item support" }];
  }
  if (type === "SERVICE") {
    doc.serviceSupport = { serviceName: `Tu van va ho tro ${n}`, provider: `Doi dich vu ${branch.code}`, estimatedHours: 1 + (i % 12), estimatedValue: 200000 + (i * 25000), note: "Seed service support" };
  }
  return doc;
});
db.aid_distributions.insertMany(aids, { ordered: false });

const actions = ["CAMPAIGN_CREATED", "CONTRIBUTION_RECEIVED", "CONTRIBUTION_CONFIRMED", "AID_DISTRIBUTION_APPROVED", "AID_DISTRIBUTION_DELIVERED", "BENEFICIARY_VERIFIED", "REPORT_VIEWED"];
const logs = Array.from({ length: 260 }, (_, i) => {
  const n = i + 1;
  const branch = branches[(i * 19) % branches.length];
  const action = actions[i % actions.length];
  const campaign = campaigns[i % campaigns.length];
  const contribution = contributions[i % contributions.length];
  const aid = aids[i % aids.length];
  let entityType = "Campaign";
  let entityId = String(campaign._id);
  if (action.startsWith("CONTRIBUTION")) {
    entityType = "Contribution";
    entityId = String(contribution._id);
  }
  if (action.startsWith("AID")) {
    entityType = "AidDistribution";
    entityId = String(aid._id);
  }
  if (action.startsWith("BENEFICIARY")) {
    entityType = "Beneficiary";
    entityId = String(ObjectId());
  }
  return {
    _id: ObjectId(),
    branchId: branch._id,
    targetBranchId: branch._id,
    actorId: ObjectId(),
    actorRole: i % 5 === 0 ? "ADMIN" : "BRANCH_STAFF",
    actorBranchId: branch._id,
    userId: ObjectId(),
    action,
    entityType,
    entityId,
    targetType: entityType,
    targetId: entityId,
    description: `Seed activity ${n}: ${action} at ${branch.code}`,
    before: { status: i % 2 === 0 ? "PENDING" : "DRAFT" },
    after: { status: i % 3 === 0 ? "COMPLETED" : "ACTIVE" },
    changes: { seedNo: n, branchCode: branch.code },
    ipAddress: `100.105.${i % 255}.${(i * 7) % 255}`,
    userAgent: "mongosh-seed-data-v2",
    createdAt: new Date(2024, i % 12, (i % 28) + 1)
  };
});
db.activity_logs.insertMany(logs, { ordered: false });

print("");
print("Seed data v2 completed.");
print(`branches: ${db.branches.countDocuments()}`);
print(`campaigns: ${db.campaigns.countDocuments()}`);
print(`contributors: ${db.contributors.countDocuments()}`);
print(`contributions: ${db.contributions.countDocuments()}`);
print(`beneficiaries: ${db.beneficiaries.countDocuments()}`);
print(`aid_distributions: ${db.aid_distributions.countDocuments()}`);
print(`activity_logs: ${db.activity_logs.countDocuments()}`);
print("");
print("Check distribution:");
print('db.contributions.getShardDistribution()');
print('db.aid_distributions.getShardDistribution()');
print('db.activity_logs.getShardDistribution()');
