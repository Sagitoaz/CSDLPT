flowchart TB
    note["Ky hieu: H = cao, M = trung binh, L = thap<br/>R = doc, W = tao, E = sua, D = xoa mem / huy"]

    subgraph global_scope["Truy cap toan he thong (SUPER_ADMIN)"]
        g_campaigns["campaigns<br/>H.R, M.WED"]
        g_contributions["contributions<br/>H.WERD"]
        g_aid["aid_distributions<br/>H.WERD"]
        g_logs["activity_logs<br/>H.R, L.W"]
        g_stats["stats_snapshots<br/>H.R, M.W"]
    end

    subgraph branch_scope["Truy cap theo branchId (BRANCH_ADMIN / STAFF)"]
        b_campaigns["campaigns<br/>H.WER, M.D"]
        b_contributions["contributions<br/>H.WERD"]
        b_beneficiaries["beneficiaries<br/>H.WER, M.D"]
        b_aid["aid_distributions<br/>H.WERD"]
        b_volunteers["volunteers<br/>H.WER"]
        b_logs["activity_logs<br/>H.R, L.W"]
        b_stats["stats_snapshots<br/>H.R, M.W"]
    end

    subgraph public_own_scope["Public / own scope (CONTRIBUTOR, DONOR, VOLUNTEER)"]
        p_campaigns["campaigns public active<br/>H.R"]
        p_contributions["contributions own data<br/>M.R"]
        p_volunteers["volunteers own profile<br/>M.R, L.WE"]
    end

    note --> g_campaigns
    note --> b_campaigns
    note --> p_campaigns

    hot["Nhom tang truong nhanh nhat:<br/>contributions, aid_distributions, activity_logs"]
    axis["branchId la truc phan quyen, loc du lieu,<br/>index va sharding quan trong nhat"]
    gateway["M1 la app gateway (FE/BE/mongos),<br/>khong phai shard du lieu trung tam"]

    g_contributions --> hot
    b_contributions --> hot
    b_aid --> hot
    b_logs --> hot
    hot --> axis
    axis --> gateway

    classDef high fill:#fff5f5,stroke:#c53030,stroke-width:1px;
    classDef mid fill:#fffaf0,stroke:#c05621,stroke-width:1px;
    classDef info fill:#eef6ff,stroke:#2b6cb0,stroke-width:1px;
    class g_contributions,b_contributions,b_aid,b_logs,hot high;
    class g_campaigns,b_campaigns,gateway mid;
    class note,axis info;