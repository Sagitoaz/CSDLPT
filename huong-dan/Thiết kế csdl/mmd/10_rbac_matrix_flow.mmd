flowchart TB
    USER["Nguoi dung"]
    AUTH["JWT + RBAC Middleware"]
    ADMIN["Admin<br/>campaign CRUD, donation review,<br/>user management, statistics, system"]
    STAFF["Staff<br/>campaign create/update,<br/>donation review, statistics"]
    DONOR["Donor<br/>view campaign, create donation,<br/>view own/limited donation, limited statistics"]

    USER --> AUTH
    AUTH -->|"role = admin"| ADMIN
