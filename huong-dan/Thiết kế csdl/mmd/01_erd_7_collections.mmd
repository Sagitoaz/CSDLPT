erDiagram
    USERS ||--o{ CAMPAIGNS : creates_or_manages
    USERS ||--o{ DONATIONS : donor_or_reviewer
    USERS ||--o{ AUDIT_LOGS : actor
    USERS ||--o{ CAMPAIGN_REPORTS : creates_or_approves
    CAMPAIGNS ||--o{ DONATIONS : code_to_campaignCode
    CAMPAIGNS ||--o{ CAMPAIGN_REPORTS : has_reports
    CAMPAIGNS ||--o{ STATS_SNAPSHOTS : has_snapshots
    DONATIONS ||--o{ PAYMENT_TRANSACTIONS : has_payment_attempts

    USERS {
        ObjectId _id PK
        string username UK
        string email UK
        string password_hash
        string fullName
        string role "system_admin|branch_admin|staff|donor"
        string branchCode "required for branch roles"
        boolean isActive
        date createdAt
        date updatedAt
    }

    CAMPAIGNS {
        ObjectId _id PK
        string code UK
        string name
        string description
        number targetAmount
        boolean isActive
        string branchCode "recommended"
        ObjectId createdBy "recommended"
        date startDate
        date endDate
        date createdAt
        date updatedAt
    }

    DONATIONS {
        ObjectId _id PK
        string donorName
        string donorEmail
        ObjectId donorUserId "optional"
        number amount
        string campaignCode FK
        string branchCode "recommended for branch sharding"
        string note
        string status "pending|verified|rejected"
        ObjectId reviewedBy "recommended"
        date reviewedAt "recommended"
        date createdAt
        date updatedAt
    }

    PAYMENT_TRANSACTIONS {
        ObjectId _id PK
        ObjectId donationId FK
        string campaignCode
        string branchCode "recommended for branch sharding"
        string donorEmail
        number amount
        string method "bank_transfer|cash|e_wallet"
        string providerTxnId
        string status "pending|success|failed|refunded"
        date paidAt
        date createdAt
        date updatedAt
    }

    CAMPAIGN_REPORTS {
        ObjectId _id PK
        string campaignCode FK
        string branchCode
        string title
        string reportPeriod
        string content
        number usedAmount
        array attachments
        string reportStatus "draft|submitted|approved|rejected"
        ObjectId createdBy
        ObjectId approvedBy
        date createdAt
        date updatedAt
    }

    AUDIT_LOGS {
        ObjectId _id PK
        string requestId
        ObjectId actorId FK
        string actorEmail
        string actorRole
        string action
        string resource
        string resourceId
        string method
        string endpoint
        number statusCode
        boolean success
        number durationMs
        date createdAt
    }

    STATS_SNAPSHOTS {
        ObjectId _id PK
        string scope "global|branch|campaign"
        string branchCode
        string campaignCode
        number totalDonations
        number totalAmount
        number pendingCount
        number verifiedCount
        number rejectedCount
        date calculatedAt
    }
