flowchart TB
    subgraph DONATION["Donation status"]
        DP["pending"] --> DV["verified"]
        DP --> DR["rejected"]
    end

    subgraph PAYMENT["Payment transaction status"]
        PP["pending"] --> PS["success"]
        PP --> PF["failed"]
        PS --> PR["refunded"]
    end

    subgraph REPORT["Campaign report status"]
        RD["draft"] --> RS["submitted"]
        RS --> RA["approved"]
        RS --> RR["rejected"]
        RR --> RD
    end

    PS -. "supports verification" .-> DV
    RA -. "public transparency" .-> REPORT_PUBLIC["public report"]
