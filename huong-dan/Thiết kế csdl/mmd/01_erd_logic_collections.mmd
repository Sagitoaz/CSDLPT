erDiagram
    CAMPAIGNS ||--o{ DONATIONS : code_to_campaignCode
    USERS ||--o{ CAMPAIGNS : future_createdBy
    USERS ||--o{ DONATIONS : future_donorUserId
    USERS ||--o{ DONATIONS : future_reviewedBy
    CAMPAIGNS ||--o{ STATS_SNAPSHOTS : future_campaignCode
    USERS ||--o{ AUDIT_LOGS : future_actorId

    USERS {
        ObjectId _id PK
        string email UK
        string password_hash
        string fullName
        string role
        boolean isActive
        date createdAt
        date updatedAt
    }

    CAMPAIGNS {
        ObjectId _id PK
        string code UK
        string name
        string description
        number targetAmount
        boolean isActive
        date startDate
        date endDate
        date createdAt
        date updatedAt
    }

    DONATIONS {
        ObjectId _id PK
        string donorName
        string donorEmail
        number amount
        string campaignCode FK
        string note
        string status
        date createdAt
        date updatedAt
    }

    AUDIT_LOGS {
        ObjectId _id PK
        string requestId
        ObjectId actorId
        string actorEmail
        string actorRole
        string action
        string resource
        string resourceId
        number statusCode
        boolean success
        date createdAt
    }

    STATS_SNAPSHOTS {
        ObjectId _id PK
        string scope
        string campaignCode
        number totalDonations
        number totalAmount
        number pendingCount
        number verifiedCount
        number rejectedCount
        date calculatedAt
    }
